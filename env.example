BOT_TOKEN=123456789:AAAA-your-token-from-BotFather
# Telegram ID того, кому разрешён доступ (узнать у @userinfobot); несколько — через запятую
ALLOWED_USER_ID=123456789
# Telegram ID администратора — ему приходят уведомления о банах (должен хотя бы раз нажать /start у бота)
ADMIN_ID=123456789
# Как часто проверять поиски, в секундах (600 = 10 минут)
POLL_INTERVAL=600
# Один или несколько прокси через запятую, только http:// (Chromium не умеет SOCKS5 с паролем)
# PROXY=http://user:pass@host1:port,http://user:pass@host2:port
# 0 — показывать окно браузера (удобно при отладке), 1 — без окна
# HEADLESS=1
# DB_PATH=avito_bot.db
# PROFILE_DIR=browser_profiles